# Environment template only; the app reads actual environment variables.
# Local demo: make dev. Production: provision accounts and serve behind HTTPS.
LEGACY_ENV=production
LEGACY_STUDIO_DATA=/data
LEGACY_UPLOAD_MB=1000
LEGACY_PUBLIC_URL=https://studio.example.com
# Set these only when connecting one workspace to a publishing workflow.
LEGACY_PUBLISH_WEBHOOK=
LEGACY_PUBLISH_WORKSPACE=
LEGACY_SIGNING_KEY=
# Optional local cookie file provided by the archive owner; never commit it.
LEGACY_YOUTUBE_COOKIE_FILE=
